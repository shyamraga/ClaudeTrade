# Copy to .env and fill in values. Never commit .env.

# SEC EDGAR user-agent (required for trader-analyst and trader-news SEC feeds)
# Format: "Your Name you@example.com"
SEC_USER_AGENT=

# Alpaca paper trading keys (get from alpaca.markets — paper keys only)
ALPACA_API_KEY=
ALPACA_SECRET_KEY=
ALPACA_PAPER_TRADE=true

# App settings
LOG_LEVEL=INFO
TRADER_DIR=./trader
SKILLS_DIR=C:/Users/shyam/.claude/skills
